<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime, not sandboxed: the app reads the pasteboard, watches folders, talks to Spotify/Music/Chrome
         via Apple Events, and runs `screencapture` / `osascript` child processes. -->
    <key>com.apple.security.automation.apple-events</key> <true/>
</dict>
</plist>
